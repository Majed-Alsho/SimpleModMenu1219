{
  "schemaVersion": 1,
  "id": "simple_mod_menu",
  "version": "v1.0.0",
  "name": "Simple Mod Menu",
  "description": "A clean single-screen mods UI: left list (real .minecraft/mods only), right detail pane, search, config launcher, reveal file, copy id/version, clickable links, export JSON.",
  "authors": ["Majed"],
  "contact": {
    "homepage": "https://github.com/Majed-Alsho/SimpleModMenu1219",
    "sources":  "https://github.com/Majed-Alsho/SimpleModMenu1219",
    "issues":   "https://github.com/Majed-Alsho/SimpleModMenu1219/issues",
    "download": "https://github.com/Majed-Alsho/SimpleModMenu1219/releases/tag/v1.0.0-1.21"
  },
  "license": "MIT",
  "icon": "assets/simple_mod_menu/icon.png",

  "environment": "client",

  "entrypoints": {
    "client": [
      "com.majed.simplemenu.SimpleModMenuClient"
    ]
  },

  "mixins": [
    "simple_mod_menu.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21"
  }
}
